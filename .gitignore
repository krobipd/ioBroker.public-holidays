# Admin custom component: the BUILT admin/custom/ stays tracked so the component ships with the
# npm package exactly as it was verified, without a build step in between. (The original reason —
# carrying it into a GitHub-URL install — is gone: `common.nogit` switched that install path off,
# and the npm deploy has been unblocked since 2026-08-21.) Only the src-admin work dirs are ignored.
/src-admin/build
/src-admin/.__mf__temp
/src-admin/.mf
/src-admin/node_modules

# Claude Code local files (not published)
.claude/settings.local.json
.claude/dev-history.md
CLAUDE.local.md

# Build output is not versioned: the CI builds before test and publish (common.nogit)
build/

# Session memory of the note-taking hook — never repository content
.remember/

# Value dumps of the object inventory run — generated, judged in the release run and the CI job
test/states.inventory.json
test/objects.inventory.de.json
